{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "cloudflare-modular-site",
  "main": "src/index.ts",
  "compatibility_date": "2026-05-08",
  "compatibility_flags": ["nodejs_compat_v2"],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*",
      "/llrgamecubecity",
      "/llrgamecubecity/assets/*",
      "/llrgamecubecity/audio/*",
      "/llrgamecubecity/fonts/*",
      "/llrgamecubecity/models/*",
      "/llrgamecubecity/textures/*",
      "/llr-mariorun",
      "/llr-mariorun/godot/index.pck",
      "/llr-mariorun/godot/index.wasm"
    ],
    "not_found_handling": "single-page-application"
  },
  "routes": [
    {
      "pattern": "neyc.de5.net/*",
      "zone_name": "neyc.de5.net"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "SITE_CONFIG",
      "id": "df768570169c407b8e8f03e8decb1176"
      // Deploy to Cloudflare requires a KV namespace id.
      // Create one with `wrangler kv namespace create SITE_CONFIG`,
      // then add: "id": "<KV_NAMESPACE_ID>"
    }
  ],
  "d1_databases": [
    {
      "binding": "GAME_DB",
      "database_name": "llr-mariorun-db",
      "database_id": "d4ddc5c7-36ac-472f-95c3-f86c831f97f6"
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
