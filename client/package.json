{
  "name": "modular-site-client",
  "version": "0.1.0",
  "description": "Desktop P2P client for Modular Site",
  "private": true,
  "main": "src/main.js",
  "type": "module",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --win nsis --x64"
  },
  "build": {
    "appId": "net.de5.modular.site.client",
    "productName": "Modular Site Client",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "src/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    }
  },
  "devDependencies": {
    "electron": "^31.7.7",
    "electron-builder": "^24.13.3"
  }
}
